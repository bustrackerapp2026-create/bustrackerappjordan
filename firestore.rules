rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userType() {
      return userDoc().data.userType;
    }

    function isAdmin() {
      return userExists() && userType() == 'admin';
    }

    function isDriver() {
      return userExists() && userType() == 'driver';
    }

    function isPassenger() {
      return userExists() && userType() == 'passenger';
    }

    function isAllowedSelfUserType(t) {
      return t in ['passenger', 'driver', 'service', 'bus_company'];
    }

    function onlySelfServiceFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'fullName',
          'phoneNumber',
          'email',
          'busNumber',
          'route',
          'capacity',
          'photoUrl',
          'currentLatitude',
          'currentLongitude',
          'heading',
          'speed',
          'isOnline',
          'isSharingLocation',
          'isTripActive',
          'lastUpdated',
          'locationUpdatedAt',
          'updatedAt'
        ]);
    }

    function passengerCancelOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'completedAt', 'cancelledBy']);
    }

    function driverTripUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'driverId',
          'notes',
          'routePoints',
          'cancelledBy'
        ]);
    }

    function tripPartiesIntact() {
      return request.resource.data.passengerId == resource.data.passengerId
        && request.resource.data.driverId == resource.data.driverId;
    }

    /// حقول مسموحة فقط في driverPublic (لا بريد/هاتف/تحقق)
    function onlyDriverPublicKeys() {
      return request.resource.data.keys().hasOnly([
        'fullName',
        'busNumber',
        'route',
        'capacity',
        'currentLatitude',
        'currentLongitude',
        'heading',
        'speed',
        'isOnline',
        'isSharingLocation',
        'isTripActive',
        'locationUpdatedAt',
        'updatedAt'
      ]);
    }

    // ── users: قراءة للمالك أو الأدمن فقط ─────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && isAllowedSelfUserType(request.resource.data.userType)
        && request.resource.data.isVerified == false
        && request.resource.data.get('isRejected', false) == false;

      allow update: if isOwner(userId) && onlySelfServiceFields()
        && request.resource.data.userType == resource.data.userType
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.get('isRejected', false) == resource.data.get('isRejected', false)
      || isAdmin();

      allow delete: if isAdmin();
    }

    // ── مواقع السائقين العامة للخريطة ─────────────────────────
    match /driverPublic/{userId} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(userId)
        && onlyDriverPublicKeys();

      allow delete: if isOwner(userId) || isAdmin();
    }

    match /pickupPoints/{pointId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.pointType in ['bus', 'passenger']
        && (
          (isAdmin() && request.resource.data.status == 'approved')
          ||
          (!isAdmin() && request.resource.data.status == 'pending')
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['confirmations', 'confirmationCount', 'reviewNote', 'suggestedEdit', 'updatedAt'])
          && request.resource.data.status == resource.data.status
          && request.resource.data.latitude == resource.data.latitude
          && request.resource.data.longitude == resource.data.longitude
          && request.resource.data.addedBy == resource.data.addedBy
        );

      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.driverId == request.auth.uid
        || resource.data.passengerId == request.auth.uid
      );

      // إنشاء: pending فقط (لا active من العميل)
      allow create: if isSignedIn()
        && (
          request.resource.data.driverId == request.auth.uid
          || request.resource.data.passengerId == request.auth.uid
        )
        && request.resource.data.keys().hasAll([
          'passengerId', 'driverId', 'status', 'pickupPoint', 'dropoffPoint'
        ])
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.passengerId == resource.data.passengerId
          && driverTripUpdateKeys()
          && (
            (resource.data.status == 'pending'
              && request.resource.data.status == 'active')
            || (resource.data.status in ['pending', 'active']
              && request.resource.data.status == 'cancelled')
            || (resource.data.status == 'active'
              && request.resource.data.status == 'completed')
            || (resource.data.status == request.resource.data.status
              && resource.data.status in ['pending', 'active'])
          )
        )
        || (
          isSignedIn()
          && resource.data.passengerId == request.auth.uid
          && resource.data.status in ['pending', 'active']
          && request.resource.data.status == 'cancelled'
          && tripPartiesIntact()
          && passengerCancelOnly()
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.driverId == request.auth.uid);
    }

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /stops/{stopId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /routeCoordinates/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /plannedRoutes/{routeId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        || (
          isDriver()
          && request.resource.data.createdBy == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          isDriver()
          && (
            resource.data.createdBy == request.auth.uid
            || resource.data.get('reRecordAllowed', false) == true
          )
          && request.resource.data.lineName == resource.data.lineName
        );

      allow delete: if isAdmin();
    }
  }
}
